{#- A single trend dossier card. Expects `t` (a RenderedTrend) in context. -#}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #eceef3; border-radius:10px;">
  <tr>
    <td style="padding:18px 20px;">

      <div style="margin-bottom:8px;">
        <span style="display:inline-block; background:{{ t.stage_color }}; color:#ffffff; font-size:11px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; padding:3px 9px; border-radius:999px;">{{ t.stage_label }}</span>
        <span style="display:inline-block; margin-left:6px; font-size:11px; color:#8a91a3; letter-spacing:1px;" title="Poziom pewności {{ t.confidence }}/5">{{ t.confidence_dots }}</span>
        {% if not t.verified %}
        <span style="display:inline-block; margin-left:6px; background:#c0392b; color:#ffffff; font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px;">NIEZWERYFIKOWANE</span>
        {% endif %}
      </div>

      {% if t.primary_link %}
      <a href="{{ t.primary_link }}" style="font-size:19px; font-weight:700; color:#13294b; text-decoration:none; line-height:1.3;">{{ t.working_name }}</a>
      {% else %}
      <div style="font-size:19px; font-weight:700; color:#13294b; line-height:1.3;">{{ t.working_name }}</div>
      {% endif %}

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:12px; font-size:13px; line-height:1.6; color:#33384d;">
        <tr><td style="width:110px; color:#8a91a3; font-weight:600; vertical-align:top; padding:2px 0;">Sylwetka</td><td style="padding:2px 0;">{{ t.silhouette }}</td></tr>
        <tr><td style="color:#8a91a3; font-weight:600; vertical-align:top; padding:2px 0;">Proporcje</td><td style="padding:2px 0;">{{ t.proportions }}</td></tr>
        <tr><td style="color:#8a91a3; font-weight:600; vertical-align:top; padding:2px 0;">Kolor</td><td style="padding:2px 0;">{{ t.color }}</td></tr>
        <tr><td style="color:#8a91a3; font-weight:600; vertical-align:top; padding:2px 0;">Materiał</td><td style="padding:2px 0;">{{ t.material }}</td></tr>
        <tr><td style="color:#8a91a3; font-weight:600; vertical-align:top; padding:2px 0;">Detal</td><td style="padding:2px 0;">{{ t.detail }}</td></tr>
        <tr><td style="color:#8a91a3; font-weight:600; vertical-align:top; padding:2px 0;">Stylizacja</td><td style="padding:2px 0;">{{ t.styling }}</td></tr>
      </table>

      <div style="margin-top:12px; font-size:13px; line-height:1.6; color:#33384d;">
        <span style="color:#8a91a3; font-weight:600;">Najwcześniejsze wystąpienia:</span> {{ t.earliest_occurrences }}
      </div>

      {% if t.designers or t.celebrities or t.subcultures or t.platforms %}
      <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#33384d;">
        <span style="color:#8a91a3; font-weight:600;">Nośniki sygnału:</span>
        {% if t.designers %}<br>&nbsp;&nbsp;projektanci/marki: {{ t.designers | join(', ') }}{% endif %}
        {% if t.celebrities %}<br>&nbsp;&nbsp;celebryci: {{ t.celebrities | join(', ') }}{% endif %}
        {% if t.subcultures %}<br>&nbsp;&nbsp;subkultury: {{ t.subcultures | join(', ') }}{% endif %}
        {% if t.platforms %}<br>&nbsp;&nbsp;platformy: {{ t.platforms | join(', ') }}{% endif %}
      </div>
      {% endif %}

      <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#33384d;">
        <span style="color:#8a91a3; font-weight:600;">Kontekst:</span> {{ t.cultural_context }}
      </div>

      {% if t.confirming_evidence %}
      <div style="margin-top:12px; font-size:13px; line-height:1.6; color:#33384d;">
        <span style="color:#1f9d55; font-weight:600;">Dowody potwierdzające:</span>
        <ul style="margin:6px 0 0 0; padding-left:18px;">
          {% for ev in t.confirming_evidence %}
          <li style="margin-bottom:4px;">
            {{ ev.text }}
            {% for label, url in ev.links %}
            <a href="{{ url }}" style="color:#1f6feb; text-decoration:none; font-size:12px;">[{{ label }}]</a>
            {% endfor %}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#33384d;">
        <span style="color:#c0392b; font-weight:600;">Dowody przeczące:</span> {{ t.contradicting_evidence }}
      </div>

      <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#33384d;">
        <span style="color:#8a91a3; font-weight:600;">Przewidywany horyzont:</span> {{ t.predicted_horizon }}
      </div>

      <div style="margin-top:10px; padding:10px 12px; background:#f7f9fc; border-radius:6px; font-size:13px; line-height:1.6; color:#13294b;">
        <span style="font-weight:700;">Konsekwencja marketingowa:</span> {{ t.marketing_implication }}
      </div>

    </td>
  </tr>
</table>
