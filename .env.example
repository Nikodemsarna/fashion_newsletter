# ---------------------------------------------------------------------------
# Marketing Signals — configuration
# Copy to `.env` for local runs, or set these as GitHub Actions secrets.
# ---------------------------------------------------------------------------

# --- Trend analysis (pick a provider) ---------------------------------------
# Set ONE API key for basic operation, or TWO for automatic failover: if the
# primary provider exhausts its retries (e.g. a multi-day outage on one
# model), the next provider with a configured key is tried automatically
# before falling back to an unverified raw grouping. Recommended: set both
# Gemini and Groq (both free). The provider is auto-detected from whichever
# key(s) are present (free providers first), or force one with
# FASHION_PROVIDER (this also disables failover — see README).
#
# Option A — Google Gemini (FREE, recommended). Get a key (no credit card) at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Option B — Groq (FREE, fast Llama models). Key at https://console.groq.com/keys
GROQ_API_KEY=
#
# Option C — Anthropic / Claude (paid; needs `pip install anthropic`).
ANTHROPIC_API_KEY=

# Optional. Force a provider (gemini | groq | anthropic) and/or model.
# Setting FASHION_MODEL disables automatic failover to a second provider,
# since a forced model name may not exist there.
FASHION_PROVIDER=
FASHION_MODEL=                  # blank = provider default (gemini-2.5-flash, etc.)
FASHION_EFFORT=high             # Anthropic only: low | medium | high | max

# --- Delivery ---------------------------------------------------------------
# Where the newsletter is sent.
NEWSLETTER_TO=nikodem.sarna@gmail.com

# Pick ONE delivery provider by setting its variables.
#
# Option A — Resend (recommended, simplest). Free tier sends from
# onboarding@resend.dev to any address; verify a domain to use your own From.
RESEND_API_KEY=
NEWSLETTER_FROM=Marketing Signals <onboarding@resend.dev>
#
# Option B — SMTP (e.g. Gmail with an App Password).
# If RESEND_API_KEY is unset but SMTP_HOST is set, SMTP is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP From defaults to SMTP_USER if NEWSLETTER_FROM is not set.

# --- Behavior ---------------------------------------------------------------
# How far back to look for "recent" news, in hours.
FASHION_WINDOW_HOURS=72
# Hard cap on how many trend-signal articles are fed to the analysis step.
FASHION_MAX_ARTICLES=60
# Hard cap on how many trend dossiers appear in one edition.
FASHION_MAX_TRENDS=8
# If no trend-signal stories are found, skip sending instead of mailing an
# empty edition (set to 0 to always send).
FASHION_SKIP_IF_EMPTY=1
